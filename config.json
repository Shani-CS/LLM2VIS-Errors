          "results": "sources/soccer/results.json",
          "images_dir": "sources/soccer/images",
          "id_format": "{query_id}"
        },
        {
          "id": "world-bank",
          "results": "sources/world-bank/results.json",
          "images_dir": "sources/world-bank/images",
          "id_format": "{query_id}"
        }
      ]
    },
    {
