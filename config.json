{
  "title": "LLM-Produced Data Visualizations: Prompts, Code, Charts & Errors",
  "spreadsheet": "prompt-error-types.xlsm",

  "columns": {
    "_comment": "The ID is the first column and the dataset the second column of each tab. Other columns are classified by these name patterns (regular expressions, case-insensitive); anything not matched becomes a filter of its own. 'rename' maps a spreadsheet column name to the label shown on the site.",
    "prompt": "^Prompt$",
    "errors": "Error",
    "error_exclude": "^Any (Data|Chart) Error$",
    "design_issues": "^(Code Design|Chart Design)",
    "evidence": "^Code Design Issue$",
    "rename": {"Sub-clauses Specified": "Clauses Specified"},
    "hidden": ["Self-corrected"]
  },

